# /etc/systemd/system/tomcat.service  —  Tomcat 10.1 a correr como serviço (AgroGest na porta 8081)
[Unit]
Description=Apache Tomcat 10.1 (AgroGest)
After=network.target

[Service]
Type=forking
User=tomcat
Group=tomcat
Environment="JAVA_HOME=/usr/lib/jvm/java-17-openjdk-amd64"
Environment="CATALINA_HOME=/opt/tomcat"
Environment="CATALINA_BASE=/opt/tomcat"
Environment="CATALINA_PID=/opt/tomcat/temp/tomcat.pid"
Environment="CATALINA_OPTS=-Xms256m -Xmx512m -Dagrogest.demo=true"
ExecStart=/opt/tomcat/bin/startup.sh
ExecStop=/opt/tomcat/bin/shutdown.sh 20
# O shutdown.sh dispara contextDestroyed() -> o AgroGest grava o estado em ficheiro.
Restart=on-failure
RestartSec=5
UMask=0027

[Install]
WantedBy=multi-user.target
